ARG NEO4J_BROWSER_IMAGE=neo4j:2026-community
FROM ${NEO4J_BROWSER_IMAGE} AS browser

FROM debian:trixie-slim
ENV JAVA_HOME=/opt/java/openjdk
COPY --from=eclipse-temurin:25 $JAVA_HOME $JAVA_HOME
# Stopgap for the eMudhra CA compromise (October 2026): stop trusting the three emSign roots
# Mozilla removed in NSS 3.131.1 (emSign ECC Root CA - G3, emSign ECC Root CA - C3, emSign Root CA - C1).
# Temurin builds from adoptium/temurin-build#4587 onwards no longer ship them; this is then a no-op.
RUN "$JAVA_HOME/bin/keytool" -list -v -cacerts -storepass changeit \
      | sed -n 's/^Alias name: //p' \
      | grep -E 'emsign_(ecc_root_ca__g3|ecc_root_ca__c3|root_ca__c1)' \
      | while read -r alias; do \
          "$JAVA_HOME/bin/keytool" -delete -cacerts -storepass changeit -alias "$alias"; \
        done
ENV PATH="${JAVA_HOME}/bin:${PATH}" \
    NEO4J_HOME="/var/lib/neo4j" \
    LANG=C.UTF-8

# =============================================================================
# Layer A: base tool-chain and su-exec. This layer does NOT depend on the Neo4j
# tarball, so it stays cached across Neo4j rebuilds. Keep it ABOVE the tarball
# COPY/ENV below, otherwise every rebuild re-downloads the whole apt package set.
# su-exec sources are vendored (copied from the build context) so the build needs
# no git/github access, which is unreliable from some networks.
# =============================================================================
COPY ./local-package/su-exec-vendor/su-exec.c ./local-package/su-exec-vendor/Makefile /su-exec/
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install --no-install-recommends -o Acquire::Retries=10 -y \
      gcc libc-dev make \
    && groupadd --gid 7474 --system neo4j \
    && useradd --uid 7474 --system --no-create-home --home "${NEO4J_HOME}" --gid neo4j neo4j \
    && cd /su-exec \
    && echo d6c40440609a23483f12eb6295b5191e94baf08298a856bab6e15b10c3b82891 su-exec.c | sha256sum -c \
    && echo 2a87af245eb125aca9305a0b1025525ac80825590800f047419dc57bba36b334 Makefile | sha256sum -c \
    && make \
    && mv /su-exec/su-exec /usr/bin/su-exec \
    && apt-get -y purge --auto-remove gcc libc-dev make \
    && apt-get install --no-install-recommends -o Acquire::Retries=10 -y \
      curl ca-certificates jq procps tini wget \
    && rm -rf /var/lib/apt/lists/* /su-exec

# =============================================================================
# Browser assets + tarball-specific values. Everything from here down invalidates
# when the Neo4j tarball changes (that is expected and cheap).
# =============================================================================
COPY --from=browser /var/lib/neo4j/web/ /opt/browser/
ENV NEO4J_SHA256=%%NEO4J_SHA%% \
    NEO4J_TARBALL=%%NEO4J_TARBALL%% \
    NEO4J_EDITION=%%NEO4J_EDITION%%
ARG NEO4J_URI=%%NEO4J_DIST_SITE%%/%%NEO4J_TARBALL%%

COPY ./local-package/* /startup/

# =============================================================================
# Layer B: extract and configure the Neo4j distribution.
# =============================================================================
RUN curl --fail --silent --show-error --location --remote-name ${NEO4J_URI} \
    && echo "${NEO4J_SHA256}  ${NEO4J_TARBALL}" | sha256sum -c --strict --quiet \
    && tar --extract --file ${NEO4J_TARBALL} --directory /var/lib \
    && mv /var/lib/neo4j-* "${NEO4J_HOME}" \
    && rm ${NEO4J_TARBALL} \
    && sed -i 's/Package Type:.*/Package Type: docker trixie/' $NEO4J_HOME/packaging_info \
    && mv /startup/neo4j-admin-report.sh "${NEO4J_HOME}"/bin/neo4j-admin-report \
    && mv "${NEO4J_HOME}"/data /data \
    && mv "${NEO4J_HOME}"/logs /logs \
    && chown -R neo4j:neo4j /data \
    && chmod -R 777 /data \
    && chown -R neo4j:neo4j /logs \
    && chmod -R 777 /logs \
    && chown -R neo4j:neo4j "${NEO4J_HOME}" \
    && chmod -R 777 "${NEO4J_HOME}" \
    && chmod -R 755 "${NEO4J_HOME}/bin" \
    && ln -s /data "${NEO4J_HOME}"/data \
    && ln -s /logs "${NEO4J_HOME}"/logs \
    && mkdir -p "${NEO4J_HOME}"/web \
    && cp /opt/browser/*.zip "${NEO4J_HOME}"/web/ \
    && chown -R neo4j:neo4j "${NEO4J_HOME}"/web \
    && rm -rf /opt/browser


ENV PATH="${NEO4J_HOME}"/bin:$PATH

WORKDIR "${NEO4J_HOME}"

VOLUME /data /logs

EXPOSE 7474 7473 7687

ENTRYPOINT ["tini", "-g", "--", "/startup/docker-entrypoint.sh"]
CMD ["neo4j"]
